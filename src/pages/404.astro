---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found | Orbit by coolLabs" description="This page does not exist. Return to Orbit or see pricing.">
  <meta slot="head" name="robots" content="noindex" />
  <section class="mx-auto max-w-xl px-4">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-fg">Page not found</h1>
    <p class="mt-5 text-fg-dim">This page does not exist. Find your way back to the workspace.</p>
    <a class="btn btn-primary btn-lg mt-8" href="/">Back to Orbit</a>
  </section>
</Layout>
