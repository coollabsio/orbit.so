---
import Icon from "./Icon.astro";
import Menu from "reicon/icons/Menu";
import { github } from "../data/links.js";
---

<header class="sticky top-0 z-50 bg-app/30 backdrop-blur-xl">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-6 px-4">
    <a href="/" class="flex shrink-0 items-center gap-2">
      <img src="/logo.svg" alt="" class="size-6" />
      <span class="text-base font-semibold tracking-tight text-fg">Orbit</span>
      <span class="rounded-full bg-orbit/15 px-1.5 py-px text-[10px] font-semibold tracking-wider text-orbit-light uppercase">Alpha</span>
    </a>
    <div class="hidden flex-1 items-center gap-0.5 sm:flex">
      <a class="navbar-link" href="/#workspace">Product</a>
      <a class="navbar-link" href="/#ai">AI</a>
      <a class="navbar-link" href="/#features">Features</a>
      <a class="navbar-link" href="/#get-orbit">Cloud & self-host</a>
    </div>
    <div class="flex items-center gap-2">
      <a class="navbar-link hidden! sm:flex!" href={github}>
        <svg class="size-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            clip-rule="evenodd"></path>
        </svg>
        GitHub
      </a>
      <a class="btn btn-primary hidden sm:inline-flex" href={github}>Star on GitHub</a>
      <button
        id="mobile-menu-button"
        type="button"
        aria-label="Toggle menu"
        aria-controls="mobile-menu"
        class="flex size-9 items-center justify-center rounded-md text-fg-dim hover:bg-white/[0.06] hover:text-fg sm:hidden"
      >
        <Icon icon={Menu} class="size-5" />
      </button>
    </div>
  </nav>
  <div id="mobile-menu" class="hidden flex-col gap-0.5 border-t border-hairline px-4 py-3 sm:hidden!">
    <a class="navbar-link" href="/#workspace">Product</a>
    <a class="navbar-link" href="/#ai">AI</a>
    <a class="navbar-link" href="/#features">Features</a>
    <a class="navbar-link" href="/#get-orbit">Cloud & self-host</a>
    <a class="navbar-link" href={github}>GitHub</a>
    <a class="btn btn-primary mt-2 w-full" href={github}>Star on GitHub</a>
  </div>
</header>
